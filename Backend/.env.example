# Variables d'environnement pour le backend
# Copier ce fichier vers .env et modifier les valeurs

# Configuration Flask
SECRET_KEY=change-this-to-a-secure-random-key
FLASK_ENV=development
FLASK_DEBUG=1

# Configuration MySQL
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=booking_dev

# Ou utiliser DATABASE_URL directement
# DATABASE_URL=mysql+pymysql://username:password@localhost:3306/booking_dev

# Configuration JWT
JWT_SECRET_KEY=change-this-jwt-secret-key
